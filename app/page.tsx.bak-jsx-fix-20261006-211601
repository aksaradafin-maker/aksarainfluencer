const money = (v: number) =>
  new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", maximumFractionDigits: 0 }).format(Number(v || 0));

async function getSettings() {
  const [rows] = await db.query(
    "SELECT * FROM sales_page_settings WHERE is_published = 1 ORDER BY id ASC LIMIT 1"
  );
  return (Array.isArray(rows) ? rows[0] : undefined) as Settings | undefined;
}

